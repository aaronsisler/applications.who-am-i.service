<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ebsolutions.applications.whoami</groupId>
    <artifactId>who-am-i-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>who-am-i-service</artifactId>
  <packaging>jar</packaging>
  <name>Who Am I Service</name>

  <properties>
    <start-class>com.ebsolutions.applications.whoami.Application</start-class>

    <!-- Base package for generated code -->
    <generated-base.package>com.ebsolutions.applications.whoami</generated-base.package>

    <!-- Contract Paths -->
    <!-- Shared schemas live in ${inbound-contracts.path}/common and are pulled in by $ref,
         so they need no execution of their own -->
    <inbound-contracts.path>${project.basedir}/src/main/resources/contracts/inbound</inbound-contracts.path>
    <inbound-actuator-contract.path>${inbound-contracts.path}/actuator.yaml</inbound-actuator-contract.path>

    <!-- Execution IDs of the OpenAPI Generator plugin -->
    <actuator-interface.execution-id>actuator-interface-id</actuator-interface.execution-id>

    <!-- Versions: Dependencies: Service -->
    <java-uuid-generator.version>5.2.0</java-uuid-generator.version>
    <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <springdoc-openapi-starter-webmvc-ui.version>3.1.1</springdoc-openapi-starter-webmvc-ui.version>

    <!-- Versions: Dependencies: Testing -->
    <!-- archunit, cucumber-bom, spring-modulith-bom and the junit-jupiter override
         are defined once in the parent -->
  </properties>

  <dependencies>
    <!-- Dependencies: Compile : Start -->

    <!-- Used for generation of UUIDv7 (see ADR 0014) -->
    <!-- Version: Explicit -->
    <dependency>
      <groupId>com.fasterxml.uuid</groupId>
      <artifactId>java-uuid-generator</artifactId>
      <version>${java-uuid-generator.version}</version>
    </dependency>

    <!-- Used for mapping between generated API models, commands and read models (see ADR 0015) -->
    <!-- Version: Explicit -->
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
      <version>${mapstruct.version}</version>
    </dependency>

    <!-- Annotations for Java classes -->
    <!-- Version: Spring Parent -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
    </dependency>

    <!-- Used for Swagger UI -->
    <!-- Version: Explicit -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc-openapi-starter-webmvc-ui.version}</version>
    </dependency>

    <!-- Exposes the actuator API health/info/etc. -->
    <!-- Version: Spring Parent -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Database access with JdbcClient and explicit SQL (see ADR 0005) -->
    <!-- Version: Spring Parent -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- Schema migrations in src/main/resources/db/migration -->
    <!-- Version: Spring Parent -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>

    <!-- Flyway support for PostgreSQL -->
    <!-- Version: Spring Parent -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Enforces module boundaries and provides module events (see ADR 0002) -->
    <!-- Version: Dependency Management - Spring Modulith BOM -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-core</artifactId>
    </dependency>

    <!-- Stores event publications until their listeners complete -->
    <!-- Version: Dependency Management - Spring Modulith BOM -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-jdbc</artifactId>
    </dependency>

    <!-- Used for validation annotations in Controller, etc. -->
    <!-- Version: Spring Parent -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Contains Spring MVC and the Tomcat web server (Boot 4 name of spring-boot-starter-web) -->
    <!-- Version: Spring Parent -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <!-- Dependencies: Compile : End -->

    <!-- Dependencies: Runtime : Start -->

    <!-- Required for driver class: org.postgresql.Driver -->
    <!-- Version: Spring Parent -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Dependencies: Runtime : End -->

    <!-- Dependencies: Test : Start -->

    <!-- Testing linkage between Cucumber and Java -->
    <!-- Version: Dependency Management - Cucumber BOM -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Testing linkage between Cucumber and JUnit -->
    <!-- Version: Dependency Management - Cucumber BOM -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Testing linkage between Cucumber and Spring context -->
    <!-- Version: Dependency Management - Cucumber BOM -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-spring</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Needed for running tests in JUnit -->
    <!-- Version: Spring Parent (junit-jupiter.version override in the parent) -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Explicit so its jar path can be passed to Surefire as a Java agent (see build) -->
    <!-- Version: Spring Parent -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Testing framework for starting Spring context, MockMvc and @WebMvcTest -->
    <!-- Includes spring-boot-starter-test -->
    <!-- Version: Spring Parent -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Used for Docker container during Acceptance tests -->
    <!-- Version: Spring Parent -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Connects Testcontainers to Spring Boot (@ServiceConnection) -->
    <!-- Version: Spring Parent -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- @ApplicationModuleTest: tests one module on its own -->
    <!-- Version: Dependency Management - Spring Modulith BOM -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Module documentation in target/spring-modulith-docs -->
    <!-- Version: Dependency Management - Spring Modulith BOM -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-docs</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Waiting for asynchronous event listeners -->
    <!-- Version: Spring Parent -->
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Architecture rules inside each module -->
    <!-- Version: Parent POM - Dependency Management -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Dependencies: Test : End -->

  </dependencies>

  <build>
    <plugins>
      <!-- Adds MapStruct to the annotation processors the parent declares (Lombok).
     The binding lets MapStruct see what Lombok generates. -->
      <!-- Version: Spring Parent -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths combine.children="append">
            <path>
              <groupId>org.mapstruct</groupId>
              <artifactId>mapstruct-processor</artifactId>
              <version>${mapstruct.version}</version>
            </path>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok-mapstruct-binding</artifactId>
              <version>${lombok-mapstruct-binding.version}</version>
            </path>
          </annotationProcessorPaths>
          <!-- MapStruct defaults for every mapper: plain @Mapper is enough (see ADR 0015).
               Set for main and test compilation alike: different settings per phase make IntelliJ
               split the module, which breaks Spotless Applier's format on save (ADR 0012).
               javac warns about these options until the first @Mapper exists, and always in
               test compilation; that warning is expected. -->
          <compilerArgs combine.children="append">
            <arg>-Amapstruct.defaultComponentModel=spring</arg>
            <arg>-Amapstruct.defaultInjectionStrategy=constructor</arg>
            <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
            <arg>-Amapstruct.unmappedSourcePolicy=ERROR</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <!-- Exposes mockito-core's jar path as the property org.mockito:mockito-core:jar -->
      <!-- Version: Spring Parent -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>mockito-agent-path</id>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Loads Mockito as a Java agent instead of letting it self-attach,
          which recent JDKs warn about and will eventually block.
          -Xshare:off: class-data sharing can't be used once an agent extends the boot classpath,
          and the JVM warns about it on every run. -->
      <!-- Version: Spring Parent -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
        </configuration>
      </plugin>

      <!-- Generates Java classes from OpenAPI contracts -->
      <!-- Shared settings come from the parent; each execution only names its contract and packages -->
      <!-- Version: Parent POM - Plugin Management -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <!-- Test-only: Actuator is implemented by Spring, so its models never go into the jar -->
          <execution>
            <id>${actuator-interface.execution-id}</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${inbound-actuator-contract.path}</inputSpec>
              <output>${project.build.directory}/generated-test-sources/openapi-actuator</output>
              <addCompileSourceRoot>false</addCompileSourceRoot>
              <addTestCompileSourceRoot>true</addTestCompileSourceRoot>
              <!-- Spring implements these endpoints; tests only need the models -->
              <generateApis>false</generateApis>
              <modelPackage>${generated-base.package}.actuator.model</modelPackage>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Gives the actuator/info API build information -->
      <!-- Version: Parent POM - Plugin Management -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

    </plugins>
  </build>

</project>
