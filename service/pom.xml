<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ebsolutions.applications.whoami</groupId>
    <artifactId>who-am-i-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>who-am-i-service</artifactId>
  <packaging>jar</packaging>
  <name>Who Am I Service</name>

  <properties>
    <start-class>com.ebsolutions.applications.whoami.Application</start-class>

    <!-- Contract Paths -->
    <!--suppress UnresolvedMavenProperty -->
    <inbound-contracts.path>${project.parent.basedir}/contracts/inbound</inbound-contracts.path>
    <inbound-common-contract.path>${inbound-contracts.path}/common.yaml</inbound-common-contract.path>
    <inbound-actuator-contract.path>${inbound-contracts.path}/actuator.yaml</inbound-actuator-contract.path>
    <inbound-app-user-contract.path>${inbound-contracts.path}/app-user.yaml</inbound-app-user-contract.path>

    <!-- Execution IDs of the OpenAPI Generator plugin -->
    <common-dto-id.executions>dto-common</common-dto-id.executions>
    <actuator-dto-id.executions>dto-actuator</actuator-dto-id.executions>
    <app-user-dto-id.executions>dto-app-user</app-user-dto-id.executions>

    <!-- Versions: Dependencies: Service -->
    <mapstruct.version>1.6.3</mapstruct.version>
    <springdoc-openapi-starter-webmvc-ui.version>3.1.1</springdoc-openapi-starter-webmvc-ui.version>

    <!-- Versions: Dependencies: Testing -->
    <archunit.version>1.5.1</archunit.version>
    <cucumber-bom.version>8.0.4</cucumber-bom.version>
    <spring-modulith-bom.version>2.1.2</spring-modulith-bom.version>
    <!-- Overrides Boot's managed JUnit (6.0.3) to match Cucumber 8's engine -->
    <!--        <junit-jupiter.version>6.1.3</junit-jupiter.version>-->
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Dependency Management: BOMs : Start -->

      <!-- Enforces package interface boundaries -->
      <!-- Version: Explicit -->
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Used for Cucumber BDD testing libs-->
      <!-- Version: Explicit -->
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-bom</artifactId>
        <version>${cucumber-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Dependency Management: BOMs : End -->

      <!-- Dependency Management: Individual : Start -->

      <!-- MapStruct annotation processor for compile time annotations -->
      <!-- Version: Explicit -->
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct-processor</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>

      <!-- Dependency Management: Individual : End -->

    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Dependencies: Compile : Start -->

    <!-- Used for mapping between OpenAPI DTO and database entity -->
    <!-- Version: Explicit -->
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
      <version>${mapstruct.version}</version>
    </dependency>

    <!-- Annotations for Java classes -->
    <!-- Version: Spring Parent -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
    </dependency>

    <!-- Used for the validation annotations -->
    <!-- Version: Explicit -->
    <!--        <dependency>-->
    <!--            <groupId>org.openapitools</groupId>-->
    <!--            <artifactId>jackson-databind-nullable</artifactId>-->
    <!--            <version>${jackson-databind-nullable.version}</version>-->
    <!--        </dependency>-->

    <!-- Used for Swagger UI and Open API annotations -->
    <!-- Version: Explicit -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc-openapi-starter-webmvc-ui.version}</version>
    </dependency>

    <!-- Exposes the actuator API health/info/etc. -->
    <!-- Version: Spring Parent -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Used for database framework -->
    <!-- Version: Spring Parent -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jdbc</artifactId>
    </dependency>

    <!-- Used for validation annotations in Controller, etc. -->
    <!-- Version: Spring Parent -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Contains Spring Boot Starter and Tomcat web server -->
    <!-- Version: Spring Parent -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Dependencies: Compile : End -->

    <!-- Dependencies: Runtime : Start -->

    <!-- Required for driver class: org.postgresql.Driver -->
    <!-- Version: Installed on runtime machine -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Dependencies: Runtime : End -->

    <!-- Dependencies: Test : Start -->

    <!-- Testing linkage between Cucumber and Java -->
    <!-- Version: Dependency Management - Cucumber BOM -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Testing linkage between Cucumber and JUnit -->
    <!-- Version: Dependency Management - Cucumber BOM -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Testing linkage between Cucumber and Spring context -->
    <!-- Version: Dependency Management - Cucumber BOM -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-spring</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Needed for running tests in JUnit -->
    <!-- Version: Dependency Management - JUnit BOM -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Explicitly add Mockito core (no inline agent needed) -->
    <!-- Version: Spring Parent -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Testing framework for starting Spring context and MockMVC -->
    <!-- Version: Spring Parent -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
      <exclusions>
        <!-- Exclude mockito-inline to avoid self-attaching agent warning -->
        <exclusion>
          <groupId>org.mockito</groupId>
          <artifactId>mockito-inline</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- Used for Docker container during Acceptance tests -->
    <!-- Version: Spring Parent -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Dependencies: Test : End -->

  </dependencies>

  <build>
    <plugins>
      <!-- Maintains strict Code Styles -->
      <!-- Version: Parent POM - Plugin Management -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>

      <!-- Generates Java classes from OpenAPI contracts -->
      <!-- Version: Parent POM - Plugin Management -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>${common-dto-id.executions}</id>
          </execution>
          <execution>
            <id>${actuator-dto-id.executions}</id>
          </execution>
          <execution>
            <id>${app-user-dto-id.executions}</id>
          </execution>
        </executions>
      </plugin>

      <!-- Gives the actuator/info API build information -->
      <!-- Version: Parent POM - Plugin Management -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

    </plugins>
  </build>

</project>
