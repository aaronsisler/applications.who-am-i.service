<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <!-- lookup parent from repository -->
    <relativePath/>
  </parent>

  <groupId>com.ebsolutions.applications.whoami</groupId>
  <artifactId>who-am-i-parent</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>Who Am I Service Parent</name>

  <modules>
    <module>service</module>
  </modules>

  <properties>
    <!-- This is the property that is propagated to all children modules -->
    <revision>0.5.0</revision>

    <!-- Versions: Project -->
    <java.version>25</java.version>

    <!-- Versions: Plugins -->
    <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
    <!-- Must match the default of the Spotless release below (see ADR 0013) -->
    <google-java-format.version>1.36.1</google-java-format.version>
    <openapi-generator-maven-plugin.version>7.26.0</openapi-generator-maven-plugin.version>
    <spotless-maven-plugin.version>3.10.4</spotless-maven-plugin.version>

    <!-- Versions: Dependencies -->
    <!-- Must match the version Spring Modulith is built against (see ADR 0013) -->
    <archunit.version>1.4.2</archunit.version>
    <cucumber-bom.version>8.0.4</cucumber-bom.version>
    <spring-modulith-bom.version>2.1.2</spring-modulith-bom.version>

    <!-- Overrides: Spring Parent -->
    <!-- Boot manages JUnit 6.0.3; Cucumber 8's JUnit Platform engine is built against 6.1 -->
    <junit-jupiter.version>6.1.3</junit-jupiter.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spring Modulith: module model, events, module tests, documentation -->
      <!-- Version: Explicit -->
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Cucumber: every test is a scenario (see ADR 0004) -->
      <!-- Version: Explicit -->
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-bom</artifactId>
        <version>${cucumber-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Architecture rules inside each module -->
      <!-- Version: Explicit -->
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Runs Lombok during compilation. Since JDK 23, javac no longer discovers annotation
             processors on the classpath by itself, so they must be listed explicitly. -->
        <!-- Version: Spring Parent -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>

        <!-- Maintains strict Code Styles; the build is the source of truth (see ADR 0011) -->
        <!-- Version: Explicit -->
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless-maven-plugin.version}</version>
          <configuration>
            <!-- Java: google-java-format, pinned to the version this Spotless release ships with -->
            <java>
              <googleJavaFormat>
                <version>${google-java-format.version}</version>
                <style>GOOGLE</style>
                <reorderImports>true</reorderImports>
              </googleJavaFormat>
              <removeUnusedImports/>
            </java>

            <!-- pom.xml: consistent element order -->
            <pom>
              <sortPom>
                <expandEmptyElements>false</expandEmptyElements>
              </sortPom>
            </pom>

            <!-- Cucumber feature files: aligned tables, consistent indentation -->
            <gherkin>
              <includes>
                <include>src/test/resources/**/*.feature</include>
              </includes>
              <gherkinUtils/>
            </gherkin>

            <!-- Markdown: CommonMark formatting, so docs look the same whoever edits them -->
            <markdown>
              <includes>
                <include>**/*.md</include>
              </includes>
              <excludes>
                <exclude>target/**</exclude>
              </excludes>
              <flexmark/>
            </markdown>

            <!-- YAML (OpenAPI contracts) and properties: whitespace only, so comments survive -->
            <!-- Structure and spacing come from .editorconfig in the IDE -->
            <formats>
              <format>
                <includes>
                  <include>src/**/*.yaml</include>
                  <include>src/**/*.yml</include>
                  <include>src/**/*.properties</include>
                </includes>
                <trimTrailingWhitespace/>
                <endWithNewline/>
              </format>
            </formats>

            <!-- SQL migrations are deliberately not listed: Flyway checksums applied migrations -->
          </configuration>
          <executions>
            <execution>
              <id>spotless-check</id>
              <goals>
                <goal>check</goal>
              </goals>
              <phase>validate</phase>
            </execution>
          </executions>
        </plugin>

        <!-- Allows for a single version to be declared in parent pom -->
        <!-- Version: Explicit -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>flatten-maven-plugin</artifactId>
          <version>${flatten-maven-plugin.version}</version>
          <configuration>
            <!-- Replaces ${revision} with the real version in the installed and deployed poms -->
            <updatePomFile>true</updatePomFile>
            <flattenMode>resolveCiFriendliesOnly</flattenMode>
          </configuration>
          <executions>
            <execution>
              <id>flatten</id>
              <goals>
                <goal>flatten</goal>
              </goals>
              <phase>process-resources</phase>
            </execution>
            <execution>
              <id>flatten-clean</id>
              <goals>
                <goal>clean</goal>
              </goals>
              <phase>clean</phase>
            </execution>
          </executions>
        </plugin>

        <!-- Generates Java classes from OpenAPI contracts (see ADR 0006) -->
        <!-- Shared options only; each module adds one execution per contract -->
        <!-- Version: Explicit -->
        <plugin>
          <groupId>org.openapitools</groupId>
          <artifactId>openapi-generator-maven-plugin</artifactId>
          <version>${openapi-generator-maven-plugin.version}</version>
          <configuration>
            <generatorName>spring</generatorName>
            <generateApis>false</generateApis>
            <generateSupportingFiles>false</generateSupportingFiles>
            <configOptions>
              <additionalModelTypeAnnotations>@lombok.Builder</additionalModelTypeAnnotations>
              <annotationLibrary>none</annotationLibrary>
              <documentationProvider>none</documentationProvider>
              <generateConstructorWithAllArgs>true</generateConstructorWithAllArgs>
              <generateJsonIncludeAnnotations>false</generateJsonIncludeAnnotations>
              <generateJsonSetterNullsAnnotations>false</generateJsonSetterNullsAnnotations>
              <generatedConstructorWithRequiredArgs>false</generatedConstructorWithRequiredArgs>
              <!-- Self implement the controllers -->
              <interfaceOnly>true</interfaceOnly>
              <openApiNullable>false</openApiNullable>
              <requestMappingMode>none</requestMappingMode>
              <requiredPropertiesMustBeNotNull>true</requiredPropertiesMustBeNotNull>
              <serializableModel>true</serializableModel>
              <!-- abstract methods: the compiler forces an implementation -->
              <skipDefaultInterface>true</skipDefaultInterface>
              <useBeanValidation>true</useBeanValidation>
              <useJackson3>true</useJackson3>
              <useSpringBoot4>true</useSpringBoot4>
              <useTags>true</useTags>
            </configOptions>
          </configuration>
        </plugin>

        <!-- Gives the actuator/info API build information -->
        <!-- Version: Spring Parent -->
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <configuration>
            <excludes>
              <exclude>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
              </exclude>
            </excludes>
          </configuration>
          <executions>
            <execution>
              <goals>
                <!-- This is providing the build info for the actuator/info endpoint -->
                <goal>build-info</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Allows for a single version to be declared in parent pom -->
      <!-- Version: Plugin Management -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
      </plugin>

      <!-- Runs here AND in every module: covers root files (README.md, CONTRIBUTING.md,
           docs/adr, this pom) as well as each module's sources -->
      <!-- Version: Plugin Management -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
