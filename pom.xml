<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <!-- lookup parent from repository -->
    <relativePath/>
  </parent>

  <groupId>com.ebsolutions.applications.whoami</groupId>
  <artifactId>who-am-i-parent</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>Who Am I Service Parent</name>

  <modules>
    <module>service</module>
  </modules>

  <properties>
    <!-- This is the property that is propagated to all children modules -->
    <revision>0.5.0</revision>

    <!-- Versions: Project -->
    <java.version>25</java.version>

    <!-- Versions: Plugins -->
    <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
    <google-java-format.version>1.36.1</google-java-format.version>
    <openapi-generator-maven-plugin.version>7.26.0</openapi-generator-maven-plugin.version>
    <spotless-maven-plugin.version>3.10.4</spotless-maven-plugin.version>
  </properties>

  <build>

    <pluginManagement>
      <plugins>
        <!-- Maintains strict Code Styles -->
        <!-- Version: Explicit -->
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless-maven-plugin.version}</version>
          <configuration>
            <java>
              <googleJavaFormat>
                <version>${google-java-format.version}</version>
                <style>GOOGLE</style>
              </googleJavaFormat>
              <removeUnusedImports/>
            </java>

            <!-- pom.xml: consistent element order -->
            <pom>
              <sortPom>
                <expandEmptyElements>false</expandEmptyElements>
              </sortPom>
            </pom>

            <!-- Cucumber feature files: aligned tables, consistent indentation -->
            <gherkin>
              <includes>
                <include>src/test/resources/**/*.feature</include>
              </includes>
              <gherkinUtils/>
            </gherkin>

            <!-- YAML (OpenAPI specs) and properties: whitespace only, so comments survive -->
            <formats>
              <format>
                <includes>
                  <include>src/**/*.yaml</include>
                  <include>src/**/*.properties</include>
                </includes>
                <trimTrailingWhitespace/>
                <endWithNewline/>
              </format>
            </formats>
          </configuration>
          <executions>
            <execution>
              <id>spotless-check</id>
              <goals>
                <goal>check</goal>
              </goals>
              <phase>validate</phase>
            </execution>
          </executions>
        </plugin>

        <!-- Allows for a single version to be declared in parent pom -->
        <!-- Version: Explicit -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>flatten-maven-plugin</artifactId>
          <version>${flatten-maven-plugin.version}</version>
        </plugin>

        <!-- Generates Java classes from OpenAPI contracts -->
        <!-- Version: Explicit -->
        <plugin>
          <groupId>org.openapitools</groupId>
          <artifactId>openapi-generator-maven-plugin</artifactId>
          <version>${openapi-generator-maven-plugin.version}</version>
          <configuration>
            <generateApis>false</generateApis>
            <generateSupportingFiles>false</generateSupportingFiles>
            <configOptions>
              <additionalModelTypeAnnotations>@lombok.Builder</additionalModelTypeAnnotations>
              <annotationLibrary>none</annotationLibrary>
              <documentationProvider>none</documentationProvider>
              <generateConstructorWithAllArgs>true</generateConstructorWithAllArgs>
              <generateJsonIncludeAnnotations>false</generateJsonIncludeAnnotations>
              <generateJsonSetterNullsAnnotations>false</generateJsonSetterNullsAnnotations>
              <generatedConstructorWithRequiredArgs>false</generatedConstructorWithRequiredArgs>
              <!-- Self implement the controllers -->
              <interfaceOnly>true</interfaceOnly>
              <openApiNullable>false</openApiNullable>
              <requestMappingMode>none</requestMappingMode>
              <requiredPropertiesMustBeNotNull>true</requiredPropertiesMustBeNotNull>
              <serializableModel>true</serializableModel>
              <!-- abstract methods: the compiler forces an implementation -->
              <skipDefaultInterface>true</skipDefaultInterface>
              <useBeanValidation>true</useBeanValidation>
              <useJackson3>true</useJackson3>
              <useSpringBoot4>true</useSpringBoot4>
              <useTags>true</useTags>
            </configOptions>
          </configuration>
        </plugin>

        <!-- Gives the actuator/info API build information -->
        <!-- Version: Spring Parent -->
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <configuration>
            <excludes>
              <exclude>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
              </exclude>
            </excludes>
          </configuration>
          <executions>
            <execution>
              <goals>
                <!-- This is providing the build info for the actuator/info endpoint -->
                <goal>build-info</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <!-- Allows for a single version to be declared in parent pom -->
        <!-- Version: Plugin Management -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
